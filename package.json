{
  "name": "@buffmomo/anyview",
  "version": "0.1.0",
  "description": "Framework-agnostic, zero-dependency universal file viewer for the web. Preview documents, spreadsheets, presentations, PDFs, images, video, audio, code and more, entirely in the browser.",
  "keywords": [
    "file-viewer",
    "document-viewer",
    "file-preview",
    "viewer",
    "preview",
    "docx",
    "xlsx",
    "pptx",
    "pdf",
    "csv",
    "markdown",
    "epub",
    "odt",
    "ods",
    "rtf",
    "web-component",
    "custom-element",
    "react",
    "vue",
    "zero-dependency",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://pushpa1105.github.io/anyview/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pushpa1105/anyview.git"
  },
  "bugs": {
    "url": "https://github.com/pushpa1105/anyview/issues"
  },
  "author": {
    "name": "pushpa1105",
    "url": "https://www.npmjs.com/org/buffmomo"
  },
  "contributors": [
    {
      "name": "pushpa1105",
      "url": "https://www.npmjs.com/org/buffmomo"
    }
  ],
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./dist/element.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "require": {
        "types": "./dist/element.d.cts",
        "default": "./dist/element.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "element": [
        "./dist/element.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ],
      "vue": [
        "./dist/vue.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "node scripts/clean.mjs",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs",
    "test:coverage": "node scripts/vitest.mjs run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack .",
    "prepublishOnly": "npm run clean && npm run lint && npm run typecheck && npm run test && npm run build && npm run check:package",
    "site": "node scripts/build-site.mjs",
    "test:browser": "npm run build && node scripts/browser-check.mjs"
  },
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "docx": "^9.16.0",
    "eslint": "^10.15.0",
    "exceljs": "^4.4.0",
    "happy-dom": "^21.0.4",
    "pdfjs-dist": "^6.5.438",
    "playwright-core": "^1.65.1",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "vue": "^3.5.46"
  }
}
